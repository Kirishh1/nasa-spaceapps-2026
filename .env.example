# NASA Earthdata Login (https://urs.earthdata.nasa.gov → Generate Token).
# A token is all you need (it also enables GPM precipitation retrieval).
EARTHDATA_TOKEN=
# Optional alternative to the token for downloads only; leave blank if you set a token.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Optional: override the data directory
SARPULSE_DATA_DIR=./data

# --- Deployment / Vercel Blob (optional locally) ---
# Storage backend: "local" (data/ folder, default) or "blob" (Vercel Blob store).
SARPULSE_STORAGE=local
# Needed locally only to run scripts/upload_to_blob.py; on Vercel the connected store provides credentials.
BLOB_READ_WRITE_TOKEN=
# Must match how the Blob store was created ("private" recommended).
SARPULSE_BLOB_ACCESS=private
SARPULSE_BLOB_PREFIX=sarpulse
