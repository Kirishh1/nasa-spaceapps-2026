    {
      "name": "Run Analysis Button",
      "kind": "button",
      "refersTo": "button-run",
      "description": "The single primary action at the end of the decision chain.",
      "html": "<button class=\"ds-btn-run\">Run analysis</button> <button class=\"ds-btn-run\" disabled>Run analysis</button>",
      "css": ".ds-btn-run{font-family:var(--font-sans),system-ui,sans-serif;display:flex;width:240px;justify-content:center;background:var(--marker);color:var(--marker-ink);border:0;border-radius:3px;padding:10px 0;font-size:13px;font-weight:700;font-stretch:110%;cursor:pointer;transition:opacity .15s}.ds-btn-run:hover{opacity:.92}.ds-btn-run:focus-visible{outline:2px solid var(--marker);outline-offset:2px}.ds-btn-run:disabled{background:var(--housing-3);color:var(--ink-3);cursor:not-allowed}"
    },
    {
      "name": "Tool Button",
      "kind": "button",
      "refersTo": "button-tool",
      "description": "Secondary tray action; marker fill when the tool is active.",
      "html": "<button class=\"ds-btn-tool\">Draw sub-area</button> <button class=\"ds-btn-tool ds-on\" aria-pressed=\"true\">Drag on the map…</button>",
      "css": ".ds-btn-tool{font-family:var(--font-sans),system-ui,sans-serif;background:transparent;color:var(--ink-2);border:1px solid var(--rule);border-radius:3px;padding:6px 10px;font-size:12px;cursor:pointer;transition:color .15s,border-color .15s}.ds-btn-tool:hover{border-color:var(--ink-3);color:var(--ink)}.ds-btn-tool:focus-visible{outline:2px solid var(--marker);outline-offset:2px}.ds-btn-tool.ds-on{background:var(--marker);border-color:var(--marker);color:var(--marker-ink)}"
    },
    {
