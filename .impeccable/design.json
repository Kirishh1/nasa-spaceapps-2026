    {
      "name": "Frame Row",
      "kind": "custom",
      "refersTo": "frame-row",
      "description": "Observation in the decision chain: live, selected, or unusable with its reason stamped.",
      "html": "<div class=\"ds-frames\"><button class=\"ds-frame\"><span class=\"ds-date\">2026-10-28</span><span class=\"ds-strip\">T069 A · F014 · HH+HV</span></button><button class=\"ds-frame ds-sel\"><span class=\"ds-date\">2026-11-09</span><span class=\"ds-strip\">T069 A · F014 · HH+HV</span></button><button class=\"ds-frame ds-bad\" disabled><span class=\"ds-date\">2026-11-02</span><span class=\"ds-strip\">T112 D · F031 · HH+HV</span><span class=\"ds-why\"><span class=\"ds-stamp\">Unusable</span>Track 112 D ≠ 69 A</span></button></div>",
      "css": ".ds-frames{display:flex;flex-direction:column;gap:4px;width:268px}.ds-frame{display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:12px;text-align:left;background:transparent;border:1px solid var(--rule);border-radius:3px;padding:6px 10px;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-frame:hover{border-color:var(--ink-3);background:var(--housing-2)}.ds-frame:focus-visible{outline:2px solid var(--marker);outline-offset:2px}.ds-date{font-family:var(--font-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums;font-size:13px;color:var(--ink)}.ds-strip{font-family:var(--font-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-sel{border-color:var(--marker);background:rgba(243,197,58,.1)}.ds-sel .ds-date{color:var(--marker)}.ds-bad{border-style:dashed;border-color:var(--rule-soft);cursor:not-allowed}.ds-bad:hover{background:transparent;border-color:var(--rule-soft)}.ds-bad .ds-date{color:var(--ink-3);text-decoration:line-through}.ds-why{font-family:var(--font-sans),system-ui,sans-serif;grid-column:span 2;margin-top:2px;font-size:11px;color:var(--ink-3)}.ds-stamp{font-family:var(--font-sans),system-ui,sans-serif;display:inline-block;margin-right:6px;border:1px solid rgba(142,140,134,.6);border-radius:2px;padding:0 4px;font-size:10.5px;font-weight:600;letter-spacing:.025em;text-transform:uppercase}"
