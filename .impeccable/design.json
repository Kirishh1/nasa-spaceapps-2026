      "css": ".ds-steps{display:flex;flex-direction:column;gap:14px}.ds-step{font-family:var(--font-sans),system-ui,sans-serif;display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;font-stretch:108%;color:var(--ink)}.ds-step b{font-weight:600}.ds-n{font-family:var(--font-mono),ui-monospace,monospace;font-variant-numeric:tabular-nums;display:flex;width:18px;height:18px;align-items:center;justify-content:center;border-radius:9999px;font-size:10px;font-weight:700;border:1px dashed var(--ink-3);color:var(--ink-3)}.ds-done{background:var(--marker);color:var(--marker-ink);border:0}.ds-next{border:1.5px solid var(--marker);color:var(--marker)}.ds-wait{color:var(--ink-3)}"
