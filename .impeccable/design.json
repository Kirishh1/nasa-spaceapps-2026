      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-b ds-on\">Overlay</button><button class=\"ds-seg-b\">Swipe earlier / later</button><button class=\"ds-seg-b\" disabled>Optical reference</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid var(--rule);border-radius:3px;padding:2px;background:var(--housing-0)}.ds-seg-b{font-family:var(--font-sans),system-ui,sans-serif;background:transparent;color:var(--ink-3);border:0;border-radius:2px;padding:4px 10px;font-size:12px;cursor:pointer}.ds-seg-b:hover{color:var(--ink)}.ds-seg-b:focus-visible{outline:2px solid var(--marker);outline-offset:2px}.ds-seg-b.ds-on{background:var(--housing-3);color:var(--ink)}.ds-seg-b:disabled{text-decoration:line-through;opacity:.6;cursor:not-allowed}"
    },
