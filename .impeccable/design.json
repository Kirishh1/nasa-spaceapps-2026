      "css": ".ds-label{font-family:var(--font-sans),system-ui,sans-serif;display:block;margin-bottom:4px;font-size:11px;font-weight:600;letter-spacing:.04em;font-stretch:112%;color:var(--ink-3)}.ds-input{font-family:var(--font-sans),system-ui,sans-serif;width:240px;background:var(--housing-2);color:var(--ink);border:1px solid var(--rule);border-radius:3px;padding:6px 10px;font-size:13px}.ds-input::placeholder{color:var(--ink-3)}.ds-input:hover{border-color:var(--ink-3)}.ds-input:focus-visible{outline:2px solid var(--marker);outline-offset:2px}"
