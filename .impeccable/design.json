      "css": ".ds-chips{display:grid;grid-template-columns:repeat(3,80px);gap:4px}.ds-chip{font-family:var(--font-sans),system-ui,sans-serif;background:transparent;color:var(--ink-2);border:1px solid var(--rule);border-radius:3px;padding:6px 0;font-size:12px;font-weight:600;cursor:pointer}.ds-chip:hover{color:var(--ink)}.ds-chip:focus-visible{outline:2px solid var(--marker);outline-offset:2px}.ds-chip.ds-on{border-color:var(--marker);background:rgba(243,197,58,.1);color:var(--marker)}.ds-chip:disabled{border-style:dashed;border-color:var(--rule-soft);color:var(--ink-3);text-decoration:line-through;cursor:not-allowed}"
